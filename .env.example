# CreateAI Studio - environment variable template.
#
# This file lists every variable the app/backend needs BY NAME ONLY.
# Never put a real value in this file - copy it and fill in the copy.
#
# The Flutter app itself does not read a .env file directly - it takes these
# same two client-safe values via --dart-define-from-file=env/dev.json (see
# env/dev.json.example and README.md "Environment configuration"). This file
# exists as the single place that documents every variable used anywhere in
# the project, backend included, for anyone auditing or onboarding.

# --- Flutter client (safe to ship in the app - see env/dev.json.example) ---
# Supabase project URL.
SUPABASE_URL=
# Supabase anon/publishable key. This is NOT a secret by design (Supabase
# issues it to be embedded in client apps) - access control comes from Row
# Level Security, not from hiding this value. Still never edit real values
# into this template file.
SUPABASE_ANON_KEY=
# The production domain published funnels are served from, e.g.
# https://your-domain.example (see docs/PHASE_7_PUBLISHING.md). Not a
# secret - only used to build the display/share link shown for a published
# funnel. Leave empty in development; nothing displays a fake production
# URL when it's unset.
PUBLIC_APP_URL=

# --- Supabase Edge Function secrets (server-side only - `supabase secrets
# set NAME=value`; NEVER placed in the Flutter app or committed anywhere) ---

# Image generation (see docs/image-generation.md)
AI_IMAGE_PROVIDER=
AI_IMAGE_MODEL=
AI_IMAGE_API_KEY=

# Music generation (see docs/music-generation.md)
MUSIC_GENERATION_PROVIDER=
MUSIC_GENERATION_MODEL=
MUSIC_GENERATION_API_KEY=

# Video generation (see docs/video-generation.md)
VIDEO_GENERATION_PROVIDER=
VIDEO_GENERATION_MODEL=
VIDEO_GENERATION_API_KEY=

# Funnel generation (see docs/funnel-generation.md)
FUNNEL_GENERATION_PROVIDER=
FUNNEL_GENERATION_MODEL=
FUNNEL_GENERATION_API_KEY=

# Funnel publishing (see docs/PHASE_7_PUBLISHING.md) - same value as the
# Flutter client's PUBLIC_APP_URL above, set as an Edge Function secret so
# publish-funnel can build the public URL it returns.
PUBLIC_APP_URL=

# Shared vendor key fallback (each *_API_KEY above falls back to this if unset
# and the provider is the matching vendor - see each doc's provider setup table)
OPENAI_API_KEY=
STABILITY_API_KEY=

# --- Auto-injected by the Supabase platform for every Edge Function - never
# set these yourself, listed here only for completeness/audit purposes ---
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
